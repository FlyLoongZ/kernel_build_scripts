-		} | grep -qvE '^(.. )?scripts/package'; then
-			printf '%s' -dirty
-		fi
+		#####if {
+		##	git --no-optional-locks status -uno --porcelain 2>/dev/null ||
+		##	git diff-index --name-only HEAD
+		##} | grep -qvE '^(.. )?scripts/package'; then
+		##	printf '%s' -dirty
+		#####fi
 
 		# All done with git
 		return
