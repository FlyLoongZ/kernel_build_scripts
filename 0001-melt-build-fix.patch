From 957878d1459209581eebc2c40a3e0e5d550ca777 Mon Sep 17 00:00:00 2001
From: FlyLoongZ <60963681+FlyLoongZ@users.noreply.github.com>
Date: Tue, 28 Jan 2025 14:37:13 +0800
Subject: [PATCH] melt build fix

---
 arch/arm64/configs/marble_defconfig |  6 +-----
 build.config.common                 |  1 -
 build.config.gki                    |  4 +---
 build.config.gki.aarch64            |  1 -
 drivers/staging/Kconfig             |  2 --
 drivers/staging/Makefile            |  1 -
 scripts/setlocalversion             | 14 +++++++-------
 7 files changed, 9 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/configs/marble_defconfig b/arch/arm64/configs/marble_defconfig
index c622c3c95..ffa29a909 100644
--- a/arch/arm64/configs/marble_defconfig
+++ b/arch/arm64/configs/marble_defconfig
@@ -1,8 +1,4 @@
-CONFIG_LOCALVERSION="-Melt"
-# CONFIG_LOCALVERSION_AUTO is not set
-CONFIG_UNAME_OVERRIDE=y
-CONFIG_UNAME_OVERRIDE_TARGET="com.google.android.gms"
-CONFIG_UNAME_OVERRIDE_STRING="5.10.177-android12-9-00001-g25f6aed0b75f-ab10758107"
+CONFIG_LOCALVERSION_AUTO=y
 CONFIG_AUDIT=y
 CONFIG_NO_HZ=y
 CONFIG_HIGH_RES_TIMERS=y
diff --git a/build.config.common b/build.config.common
index 9ec1c637a..0b67b94d6 100644
--- a/build.config.common
+++ b/build.config.common
@@ -11,6 +11,5 @@ KCFLAGS="${KCFLAGS} -D__ANDROID_COMMON_KERNEL__"
 EXTRA_CMDS=''
 STOP_SHIP_TRACEPRINTK=1
 IN_KERNEL_MODULES=1
-DO_NOT_STRIP_MODULES=1
 
 HERMETIC_TOOLCHAIN=${HERMETIC_TOOLCHAIN:-1}
diff --git a/build.config.gki b/build.config.gki
index 44d4ed1be..9bee41510 100644
--- a/build.config.gki
+++ b/build.config.gki
@@ -1,3 +1 @@
-DEFCONFIG=gki_defconfig
-POST_DEFCONFIG_CMDS="check_defconfig"
-
+DEFCONFIG=marble_defconfig
diff --git a/build.config.gki.aarch64 b/build.config.gki.aarch64
index 452ed209b..0e54be5cc 100644
--- a/build.config.gki.aarch64
+++ b/build.config.gki.aarch64
@@ -45,7 +45,6 @@ arch/arm64/boot/Image.lz4
 
 TRIM_NONLISTED_KMI=${TRIM_NONLISTED_KMI:-1}
 KMI_SYMBOL_LIST_STRICT_MODE=${KMI_SYMBOL_LIST_STRICT_MODE:-1}
-MODULES_ORDER=android/gki_aarch64_modules
 KMI_ENFORCED=1
 
 if [ -n "${GKI_DEFCONFIG_FRAGMENT}" ]; then
diff --git a/drivers/staging/Kconfig b/drivers/staging/Kconfig
index 7d42ad874..e81551577 100644
--- a/drivers/staging/Kconfig
+++ b/drivers/staging/Kconfig
@@ -120,8 +120,6 @@ source "drivers/staging/hikey9xx/Kconfig"
 
 source "drivers/staging/qcacld-3.0/Kconfig"
 
-source "drivers/staging/kernelsu/Kconfig"
-
 source "drivers/staging/extend_reclaim/Kconfig"
 
 source "drivers/staging/binder_prio/Kconfig"
diff --git a/drivers/staging/Makefile b/drivers/staging/Makefile
index 91660fb2d..7e6efe241 100644
--- a/drivers/staging/Makefile
+++ b/drivers/staging/Makefile
@@ -50,6 +50,5 @@ obj-$(CONFIG_QLGE)		+= qlge/
 obj-$(CONFIG_WFX)		+= wfx/
 obj-y				+= hikey9xx/
 obj-$(CONFIG_QCA_CLD_WLAN)	+= qcacld-3.0/
-obj-$(CONFIG_KSU)		+= kernelsu/
 obj-$(CONFIG_EXTEND_RECLAIM)	+= extend_reclaim/
 obj-$(CONFIG_BINDER_PRIO)	+= binder_prio/
diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index 842936656..963355a75 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -98,7 +98,7 @@ scm_version()
 			# again using exactly 12 hex chars.
 			else
 				head="$(echo $head | cut -c1-12)"
-				printf '%s%s' -g $head
+				printf '%s%05d%s%s' - $(( ( $(od -An -N1 -tu1 < /dev/urandom) % 113 ) + 16 )) -g $head
 			fi
 		fi
 
@@ -113,12 +113,12 @@ scm_version()
 		# it fails. Note that git-diff-index does not refresh the
 		# index, so it may give misleading results. See
 		# git-update-index(1), git-diff-index(1), and git-status(1).
-		if {
-			git --no-optional-locks status -uno --porcelain 2>/dev/null ||
-			git diff-index --name-only HEAD
-		} | grep -qvE '^(.. )?scripts/package'; then
-			printf '%s' -dirty
-		fi
+		##if {
+		##	git --no-optional-locks status -uno --porcelain 2>/dev/null ||
+		##	git diff-index --name-only HEAD
+		##} | grep -qvE '^(.. )?scripts/package'; then
+		##	printf '%s' -dirty
+		##fi
 
 		# All done with git
 		return
-- 
2.48.1

